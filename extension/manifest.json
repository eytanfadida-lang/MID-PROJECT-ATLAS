{
  "manifest_version": 3,
  "name": "אפרת רוזנברג CRM - תוסף וואטסאפ",
  "version": "0.1.0",
  "description": "מציג מידע מה-CRM (ליד, סטטוס, מנוי, הערות) ותגובות מהירות ישירות בתוך WhatsApp Web",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://eytan1985.pythonanywhere.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content-world.js"],
      "world": "MAIN",
      "run_at": "document_idle"
    },
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
